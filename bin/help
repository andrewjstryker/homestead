#!/bin/sh
#
# Print a Makefile's target list, taken from `.PHONY: name #> description`.
#
# usage: help <makefile>...
#
set -eu

printf 'Targets:\n'

awk '/^\.PHONY:[ \t]+[a-zA-Z0-9_-]+[ \t]+#>/ {
	split($0, parts, "#>")
	printf "  %-20s %s\n", $2, substr(parts[2], 2)
}' "$@"

printf '\nVariables:\n'
printf '  %-20s %s\n' 'DESTDIR' 'staged-root prefix for every written path'
printf '  %-20s %s\n' 'XDG_CONFIG_HOME' 'root of installed configuration'
