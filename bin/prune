#!/bin/sh
# Remove public stage entries which are no longer declared by src.
set -eu

stage=${1:?usage: prune <stage> [expected-path ...]}
shift

[ -d "$stage" ] || exit 0

expected() {
	prune_candidate=$1
	shift
	for prune_expected do
		[ "$prune_candidate" = "$prune_expected" ] && return 0
	done
	return 1
}

# Files first, then empty directories from the leaves upward. Any path with a
# dot-prefixed directory component is private and deliberately left alone.
find "$stage" \( -type f -o -type l \) -print | while IFS= read -r path; do
	relative=${path#"$stage"/}
	case $relative in .* | */.*) continue ;; esac
	if ! expected "$path" "$@"; then
		rm -f "$path"
		printf 'pruned %s\n' "$path"
	fi
done

find "$stage" -depth -type d -print | while IFS= read -r path; do
	[ "$path" = "$stage" ] && continue
	relative=${path#"$stage"/}
	case $relative in .* | */.*) continue ;; esac
	if ! expected "$path" "$@" && rmdir "$path" 2>/dev/null; then
		printf 'pruned %s/\n' "$path"
	fi
done
