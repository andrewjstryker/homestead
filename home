#!/bin/sh
#
# home — Homestead collection driver.
#
# Coordinates independent module Makefiles through the Homestead interface.
# Collection policy lives in one environment table and a small wrapper.
#
# usage: home [--root DIR] [--env FILE] [--first LIST] [--last LIST] <verb> [module...] [options]
#
#   show       [module...]    print resolved paths and modules
#   check      [module...]    run full preflight without staging or installing
#   stage      [module...]    realize each module's complete installation tree
#   preview    [module...]    report files install would create or overwrite
#   install    [module...]    install each module's declared payload
#   sync       [module...]    synchronize runtime and network state
#   apply      [module...]    install all, then sync all
#   uninstall  [module...]    remove what install created
#   clean      [module...]    remove build artifacts
#   test       [module...]    run module-owned behavioral tests when provided
#   help                       this message
#
# With no module named, a command acts on every discovered module.
# Name one or more to narrow it:
#
#   home install zsh nvim
#   home install -- command [argument...]
#   home uninstall --dry-run base
#
# options:
#   -- COMMAND [ARG...]     run after successful live install (not with --destdir)
#   --root DIR              collection directory (before verb; default: cwd)
#   --env FILE              environment table (default: .env in the collection)
#   --first LIST            shared environment providers (overrides MODULES_FIRST)
#   --last LIST             environment consumers (overrides MODULES_LAST)
#   --dry-run               preview destination changes (staging may write locally)
#   --destdir DIR           staged-root prefix for every written path
#
# environment: ignored, apart from process plumbing (HOME, PATH, the terminal,
# locale, and session sockets). Every module reads the one table, as NAME=value
# lines, and supplies its own defaults; MODULES_FIRST and MODULES_LAST there
# are space-separated module names.
#
set -eu

# Resolve code and collection independently; the driver may live in _homestead.
script_dir=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
script=${script_dir}/home

#------------------------------------------------------------------------------#
# Environment policy
#
# Inputs come from one table, never the inherited environment. Installed
# modules export their values into every shell through env.d fragments
# (MAILDIR, the XDG roots, ...). Read back as inputs, the last install would
# decide the next one: a changed default or table entry would lose to a stale
# export, and the build would stamp that export in again. So the driver
# restarts itself with only process plumbing, names the table, and passes each
# module only that name. Every module enforces the same rule in prelude.mk.
#------------------------------------------------------------------------------#

if [ "${HOMESTEAD_SCRUBBED-}" != 1 ]; then
	count=$#
	set -- "$@" env -i HOMESTEAD_SCRUBBED=1
	# A trailing * in the plumbing list is a name prefix, such as LC_*.
	for entry in $(cat "$script_dir/plumbing"); do
		case $entry in
			*'*') names=$(env | sed -n "s/^\(${entry%'*'}[A-Za-z0-9_]*\)=.*/\1/p") ;;
			*) names=$entry ;;
		esac
		for name in $names; do
			present=
			value=
			eval "present=\${$name+x}"
			[ "$present" = x ] || continue
			eval "value=\${$name}"
			set -- "$@" "$name=$value"
		done
	done
	set -- "$@" /bin/sh "$script"
	# Move the original arguments behind the command they now belong to.
	while [ "$count" -gt 0 ]; do
		set -- "$@" "$1"
		shift
		count=$((count - 1))
	done
	exec "$@"
fi
unset HOMESTEAD_SCRUBBED
DESTDIR=

# Every list this script splits is newline-separated, so that paths containing
# spaces survive word splitting.  Command flags are therefore always written
# literally, never accumulated in a variable.
newline='
'
IFS=$newline

# Resolve the table as every module does: by asking Make, through the same
# prelude, which also rejects empty roots. Module names in the ordering lists
# are space-separated there.
load_table() {
	table=$(make --no-print-directory -s -f "$script_dir/table.mk" \
		ENV_FILE="$env_file" table) || exit 2
	table_names=
	MODULES_FIRST=
	MODULES_LAST=
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		name=${line%%=*}
		eval "$name=\${line#*=}"
		table_names="${table_names}${table_names:+${newline}}${name}"
	done <<EOF
$table
EOF
	# Options carry a leading = so that an explicitly empty list still counts.
	[ -z "$first_option" ] || MODULES_FIRST=${first_option#=}
	[ -z "$last_option" ] || MODULES_LAST=${last_option#=}
}

# Every module invocation names the table and nothing else of the collection.
module_make() {
	module_dir=$1
	shift
	make --no-print-directory -C "$module_dir" ENV_FILE="$env_file" "$@"
}

#------------------------------------------------------------------------------#
# Modules
#
# Anything one level down with a Makefile.  How it got there — submodule,
# clone, symlink — is not our business. Names beginning with _ or . are private.
#------------------------------------------------------------------------------#

# Collection ordering policy. These configurable lists are filtered against the modules
# selected for each command: named first modules lead, named last modules
# trail, and every other selected module retains its discovery order.
listed() {
	needle=$1
	list=$2
	for item in $list; do
		[ "$item" = "$needle" ] && return 0
	done
	return 1
}

resolve_ordering() {
	modules_first=$(printf '%s\n' "$MODULES_FIRST" | tr ' \t' '\n\n' | sed '/^$/d')
	modules_last=$(printf '%s\n' "$MODULES_LAST" | tr ' \t' '\n\n' | sed '/^$/d')
	for module in $modules_first; do
		if listed "$module" "$modules_last"; then
			printf 'home: module is both first and last: %s\n' "$module" >&2
			exit 2
		fi
	done
}

module_repos() {
	for dir in */; do
		case $dir in _* | .*) continue ;; esac
		[ -f "${dir}Makefile" ] || continue
		printf '%s\n' "${dir%/}"
	done | order_repos
}

# Configured first modules, the stable middle, then configured last modules.
# The ordering delivers runtime floor fragments before domain contributions.
# Consumers also stage available first modules, without implicitly installing them.
order_repos() {
	all=$(cat)

	for wanted in $modules_first; do
		for repo in $all; do
			[ "$repo" = "$wanted" ] && printf '%s\n' "$repo"
		done
	done

	for repo in $all; do
		listed "$repo" "$modules_first" && continue
		listed "$repo" "$modules_last" && continue
		printf '%s\n' "$repo"
	done

	for wanted in $modules_last; do
		for repo in $all; do
			[ "$repo" = "$wanted" ] && printf '%s\n' "$repo"
		done
	done

	# A missing configured module is normal for a partial selection. Do not let
	# the final failed comparison become the function's status under `set -e`.
	:
}

# Resolve the modules to act on: those named on the command line, or all
# of them when none were named.  An unknown name is a usage error rather than
# a silent no-op — a typo must not look like a successful install.
resolve_repos() {
	available=$(module_repos)

	if [ -z "$selected" ]; then
		printf '%s' "$available"
		return 0
	fi

	unknown=
	for name in $selected; do
		listed "$name" "$available" || unknown="${unknown} ${name}"
	done

	# Named modules are ordered too: "home install zsh base" is a
	# request for those two, not a request to install them backwards.
	if [ -z "$unknown" ]; then
		printf '%s' "$selected" | order_repos
		return 0
	fi

	printf 'home: no such module:%s\n' "$unknown" >&2
	if [ -n "$available" ]; then
		printf 'available:' >&2
		for repo in $available; do
			printf ' %s' "$repo" >&2
		done
		printf '\n' >&2
	else
		printf 'no modules found\n' >&2
	fi
	exit 2
}

# Whether the operation includes a consumer that composes others' fragments.
selection_has_last() {
	for repo in $operation_repos; do
		listed "$repo" "$modules_last" && return 0
	done
	return 1
}

# Check, stage, and installation failures are always errors. Other commands retain
# selection-based severity: explicit modules and first/last anchors are strict.
failure_is_fatal() {
	repo=$1
	case $failure_policy in collect | stop) return 0 ;; esac
	[ -n "$selected" ] && return 0
	listed "$repo" "$modules_first" && return 0
	listed "$repo" "$modules_last" && return 0
	return 1
}

# Called from guarded Make invocations; do not rely on errexit inside functions.
record_failure() {
	excluded_repos="${excluded_repos-}${excluded_repos:+${newline}}$2"
	if [ "$failure_policy" = stop ]; then
		printf '\nFAILED (%s): %s\n' "$1" "$2" >&2
		return 1
	fi
	if failure_is_fatal "$2"; then
		failed="${failed} $2"
	else
		warned="${warned} $2"
	fi
}

report_failures() {
	phase=$1
	warned=$2
	failed=$3

	if [ -n "$warned" ]; then
		printf '\nWARNING (%s):%s\n' "$phase" "$warned" >&2
	fi
	if [ -n "$failed" ]; then
		printf '\nFAILED (%s):%s\n' "$phase" "$failed" >&2
		return 1
	fi
	return 0
}

# A consumer refreshes the available foundations even on a targeted build.
# Keep repos (the user selection) separate from operation_repos (build work).
expand_stage_selection() {
	for repo in $operation_repos; do
		listed "$repo" "$modules_last" || continue
		for candidate in $(module_repos); do
			listed "$candidate" "$modules_first" || continue
			listed "$candidate" "$operation_repos" && continue
			operation_repos="${operation_repos}${newline}${candidate}"
		done
		operation_repos=$(printf '%s\n' "$operation_repos" | order_repos)
		break
	done
}

# Only requested modules need installation tools. Implicit foundations are
# build inputs, so retain them for staging without preflighting installation.
preflight_selected_install() {
	implicit_repos=
	selected_ready=
	for repo in $operation_repos; do
		if listed "$repo" "$repos"; then
			selected_ready="${selected_ready}${selected_ready:+${newline}}${repo}"
		else
			implicit_repos="${implicit_repos}${implicit_repos:+${newline}}${repo}"
		fi
	done
	operation_repos=$selected_ready
	install_preflight_status=0
	preflight_tools install || install_preflight_status=$?
	operation_repos=$(printf '%s\n%s\n' "$implicit_repos" "$operation_repos" | sed '/^$/d' | order_repos)
	return "$install_preflight_status"
}

retain_selected() {
	selected_ready=
	for repo in $operation_repos; do
		listed "$repo" "$repos" || continue
		selected_ready="${selected_ready}${selected_ready:+${newline}}${repo}"
	done
	operation_repos=$selected_ready
}

# Refresh selected producers and implicit foundations before consumers. Middle
# modules not selected are never rebuilt; their existing stage is their input.
stage_before_last() {
	staged_repos=
	selection_has_last || return 0

	warned=
	failed=
	ready=

	for repo in $operation_repos; do
		if listed "$repo" "$modules_last"; then
			ready="${ready}${ready:+${newline}}${repo}"
			continue
		fi

		if stage_output=$(module_make "$repo" stage 2>&1)
		then
			staged_repos="${staged_repos}${staged_repos:+${newline}}${repo}"
			ready="${ready}${ready:+${newline}}${repo}"
			continue
		fi

		printf '\n==> %s: stage\n' "$repo" >&2
		[ -z "$stage_output" ] || printf '%s\n' "$stage_output" >&2
		record_failure stage "$repo" || return 1
	done

	operation_repos=$ready
	report_failures stage "$warned" "$failed"
}

# Stage is the composition state. Inspect staged fragments from every available
# producer, not its current source/vendor manifest. Exclude any producer that
# failed this operation so stale or partial outputs cannot mask that failure.
collect_fragments() {
	fragments=
	selection_has_last || return 0

	warned=
	failed=
	for repo in $(module_repos); do
		listed "$repo" "$modules_last" && continue
		listed "$repo" "${excluded_repos-}" && continue
		if fragment_output=$(module_make "$repo" staged-fragment-files); then
			:
		else
			printf 'home: could not inspect staged fragments for %s\n' "$repo" >&2
			[ "$failure_policy" != selection ] || return 1
			record_failure inspect "$repo" || return 1
			continue
		fi
		while IFS= read -r source; do
			[ -n "$source" ] || continue
			case $source in
				/*) fragment_path=$source ;;
				*) fragment_path=$PWD/$repo/$source ;;
			esac
			fragments="${fragments}${fragments:+${newline}}${fragment_path}"
		done <<EOF
$fragment_output
EOF
	done
	ready=
	for repo in $operation_repos; do
		listed "$repo" "${excluded_repos-}" && continue
		ready="${ready}${ready:+${newline}}${repo}"
	done
	operation_repos=$ready
	report_failures inspect "$warned" "$failed"
}

# Run a make target in each selected module.
#
# The command chooses whether to collect failures or stop immediately.
# Completed writes and receipts are never rolled back.
recurse() {
	target=$1
	warned=
	failed=
	succeeded=

	if [ -z "$operation_repos" ]; then
		printf 'No modules found.\n'
		return 0
	fi

	for repo in $operation_repos; do
		printf '\n==> %s: %s\n' "$repo" "$target"
		fragment_input=
		listed "$repo" "$modules_last" && fragment_input=${fragments-}
		if module_make "$repo" "$target" \
		       DESTDIR="${DESTDIR}" ENV_FRAGMENTS="$fragment_input" \
		       DRY_RUN="$([ "$dry_run" = yes ] && printf 1)"
		then
			succeeded="${succeeded}${succeeded:+${newline}}${repo}"
		else
			record_failure "$target" "$repo" || return 1
		fi
	done

	operation_repos=$succeeded
	report_failures "$target" "$warned" "$failed"
}

# Test support is deliberately outside homestead.mk. A module may expose a
# `test` target using any framework or none at all. Probe Make's public target
# database; a missing target is a normal skip, while a parse failure or failed
# test is handled by the collection failure policy.
target_exists() {
	repo=$1
	database=
	probe_status=0
	target_probe_status=0
	database=$(module_make "$repo" -qp 2>&1) || probe_status=$?
	if [ "$probe_status" -gt 1 ]; then
		target_probe_output=$database
		target_probe_status=2
		return 2
	fi
	printf '%s\n' "$database" | awk '
		$0 == "test:" && previous != "# Not a target:" { found=1 }
		{ previous=$0 }
		END { exit !found }'
	target_probe_status=$?
	return "$target_probe_status"
}

cmd_test() {
	warned=
	failed=

	for repo in $operation_repos; do
		if target_exists "$repo"; then
			printf '\n==> %s: test\n' "$repo"
			fragment_input=
			listed "$repo" "$modules_last" && fragment_input=${fragments-}
			if module_make "$repo" test \
			       DESTDIR="${DESTDIR}" ENV_FRAGMENTS="$fragment_input" \
			       DRY_RUN="$([ "$dry_run" = yes ] && printf 1)"; then
				:
			elif failure_is_fatal "$repo"; then
				failed="${failed} ${repo}"
			else
				warned="${warned} ${repo}"
			fi
			continue
		fi

		if [ "$target_probe_status" -eq 1 ]; then
			printf '\n==> %s: test (skipped: no test target)\n' "$repo"
			continue
		fi
		printf '\n==> %s: test target discovery failed\n' "$repo" >&2
		[ -z "${target_probe_output-}" ] || printf '%s\n' "$target_probe_output" >&2
		if failure_is_fatal "$repo"; then
			failed="${failed} ${repo}"
		else
			warned="${warned} ${repo}"
		fi
	done

	report_failures test "$warned" "$failed"
}

# Check one phase across the complete selection before any module enters it.
# Direct Make invocation is protected by the same targets; this collection
# preflight prevents an early module from mutating before a later one reports
# a missing tool.
preflight_tools() {
	phase=$1
	target=check-${phase}-tools
	warned=
	failed=
	ready=

	for repo in $operation_repos; do
		if tool_output=$(module_make "$repo" "$target" \
		     DESTDIR="${DESTDIR}" DRY_RUN="$([ "$dry_run" = yes ] && printf 1)" \
		     2>&1); then
			ready="${ready}${ready:+${newline}}${repo}"
			continue
		fi

		printf '\n==> %s: %s\n' "$repo" "$target" >&2
		[ -z "$tool_output" ] || printf '%s\n' "$tool_output" >&2
		record_failure "$target" "$repo" || return 1
	done

	operation_repos=$ready
	report_failures "$target" "$warned" "$failed"
}

#------------------------------------------------------------------------------#
# Commands
#------------------------------------------------------------------------------#

cmd_help() {
	# The header comment block, minus the shebang, is the help text.
	awk 'NR < 3 { next }
	     !/^#/  { exit }
	            { sub(/^# ?/, ""); print }' "${script}"
}

cmd_show() {
	printf 'Environment:\n'
	printf '  HOME............... %s\n' "${HOME}"
	printf '  XDG_CONFIG_HOME.... %s\n' "${XDG_CONFIG_HOME}"
	printf '  XDG_DATA_HOME...... %s\n' "${XDG_DATA_HOME}"
	printf '  XDG_STATE_HOME..... %s\n' "${XDG_STATE_HOME}"
	printf '  XDG_CACHE_HOME..... %s\n' "${XDG_CACHE_HOME}"
	printf '  XDG_RUNTIME_DIR.... %s\n' "${XDG_RUNTIME_DIR:-(unset — supplied by the session manager)}"
	printf '  BIN_DIR............ %s\n' "${BIN_DIR}"
	printf '  LIBEXEC_DIR........ %s\n' "${LIBEXEC_DIR}"
	printf '  DESTDIR............ %s\n' "${DESTDIR}"
	printf '  ENV_FILE........... %s\n' "${env_file:-(none)}"
	printf '  MODULES_FIRST...... %s\n' "${MODULES_FIRST}"
	printf '  MODULES_LAST....... %s\n' "${MODULES_LAST}"

	printf '\nModules'
	[ -z "$selected" ] || printf ' (selected)'
	printf ':\n'

	if [ -n "$repos" ]; then
		for repo in $repos; do
			printf '  %s\n' "$repo"
		done
	else
		printf '  (none)\n'
	fi

	recurse show
}

cmd_install() {
	expand_stage_selection
	preflight_tools stage || return 1
	preflight_selected_install || return 1
	stage_before_last || return 1
	collect_fragments || return 1
	retain_selected
	recurse install || return 1
}

cmd_preview() {
	expand_stage_selection
	preflight_tools stage
	preflight_selected_install
	stage_before_last
	collect_fragments
	retain_selected
	recurse preview
}

cmd_stage() {
	expand_stage_selection
	stage_status=0
	preflight_tools stage || stage_status=1
	stage_before_last || stage_status=1
	collect_fragments || stage_status=1
	# Producers staged for composition are already complete. Only stage the
	# remaining modules, avoiding a second attempt or duplicate side effects.
	remaining=
	for repo in $operation_repos; do
		listed "$repo" "$staged_repos" && continue
		remaining="${remaining}${remaining:+${newline}}${repo}"
	done
	operation_repos=$remaining
	recurse stage || stage_status=1
	return "$stage_status"
}

cmd_sync() {
	if [ -n "$DESTDIR" ]; then
		printf 'home: sync has no staged meaning; omit --destdir\n' >&2
		return 2
	fi
	preflight_tools sync
	recurse sync
}

cmd_apply() {
	cmd_install || return 1

	# DESTDIR proves filesystem installation in isolation. Synchronization acts
	# on live tools or state and therefore has no staged meaning.
	if [ -n "$DESTDIR" ]; then
		printf '\nSync skipped for staged apply.\n'
	else
		preflight_tools sync || return 1
		recurse sync || return 1
	fi
}

cmd_uninstall() {
	# Installation receipts outlive sources and stage; no fragment composition.
	preflight_tools uninstall
	recurse uninstall
}

cmd_clean() {
	recurse clean
}

# Validate each module, then compare destinations of successful modules.
cmd_check() {
	if [ -z "$repos" ]; then
		printf 'No modules found.\n'
		return 0
	fi

	check_status=0
	recurse check || check_status=$?
	check_collisions || check_status=1
	return "$check_status"
}

# Compare resolved destinations, including link paths and file/ancestor conflicts.
# Inspect successful modules only, retaining their established failure policy.
check_collisions() (
    records=$(mktemp)
    trap 'rm -f "$records"' EXIT HUP INT TERM
    for repo in $operation_repos; do
        inspection=$(module_make "$repo" inspect) || return 1
        printf '%s\n' "$inspection" |
            awk -F '\t' -v owner="$repo" '
                $1 == "file" || $1 == "link" { print $5 "\t" owner }
            ' >> "$records"
    done
    LC_ALL=C sort -u "$records" | awk -F '\t' '
        function collision(a, b, i, j, left, right) {
            split(owners[a], left, "\t")
            split(owners[b], right, "\t")
            for (i in left) for (j in right) {
                if (left[i] != right[j] && (a != b || left[i] < right[j])) {
                    printf "home: destination collision: %s (%s) and %s (%s)\n", \
                        a, left[i], b, right[j] > "/dev/stderr"
                    failed = 1
                }
            }
        }
        { owners[$1] = owners[$1] (owners[$1] == "" ? "" : "\t") $2 }
        END {
            for (path in owners) {
                collision(path, path)
                parent = path
                while (sub(/\/[^/]*$/, "", parent) && parent != "")
                    if (parent in owners) collision(parent, path)
            }
            exit failed
        }
    '

)

#------------------------------------------------------------------------------#
# Dispatch
#------------------------------------------------------------------------------#

root_option=
env_option=
first_option=
last_option=

# Table options, accepted before or after the verb. Sets consumed to the
# number of arguments used. A later --first or --last replaces an earlier.
table_option() {
	consumed=1
	case $1 in
		--env)
			[ "$#" -ge 2 ] && [ -n "$2" ] || { printf 'home: --env requires a file\n' >&2; exit 2; }
			env_option=$2
			consumed=2
			;;
		--env=*)
			env_option=${1#--env=}
			[ -n "$env_option" ] || { printf 'home: --env requires a file\n' >&2; exit 2; }
			;;
		--first | --last)
			[ "$#" -ge 2 ] || { printf 'home: %s requires a module list\n' "$1" >&2; exit 2; }
			eval "${1#--}_option==\$2"
			consumed=2
			;;
		--first=* | --last=*)
			option=${1%%=*}
			eval "${option#--}_option==\${1#*=}"
			;;
	esac
}

# Collection options may precede the verb, so a wrapper can fix policy and
# still pass any verb through.
while [ $# -gt 0 ]; do
	case $1 in
		--root)
			[ "$#" -ge 2 ] && [ -n "$2" ] || {
				printf 'home: --root requires a directory\n' >&2
				exit 2
			}
			root_option=$2
			shift
			;;
		--env | --env=* | --first | --first=* | --last | --last=*)
			table_option "$@"
			shift $((consumed - 1))
			;;
		*)
			break
			;;
	esac
	shift
done

command=${1:-help}
[ $# -eq 0 ] || shift
case $command in -h | --help) command=help ;; esac

dry_run=no
post_command=no
selected=

# Options and module names may be interleaved, so that both
# "home install zsh --dry-run" and its option-first form both work.
while [ $# -gt 0 ]; do
	case $1 in
        --)
            shift
            [ "$#" -gt 0 ] || { echo 'home: -- requires a command' >&2; exit 2; }
            post_command=yes
            break
            ;;
		--dry-run)
			dry_run=yes
			;;
		--env | --env=* | --first | --first=* | --last | --last=*)
			table_option "$@"
			shift $((consumed - 1))
			;;
		--destdir)
			shift
			DESTDIR=${1:?--destdir requires a directory}
			;;
		--destdir=*)
			DESTDIR=${1#--destdir=}
			;;
		-h | --help)
			command=help
			;;
		-*)
			printf 'home: unknown option: %s\n' "$1" >&2
			exit 2
			;;
		*)
			selected="${selected}${selected:+${newline}}$1"
			;;
	esac
	shift
done

case $command in
	install | sync | apply | uninstall | test)
		;;
	show | stage | preview | clean | check)
		if [ "$dry_run" = yes ]; then
			printf 'home: %s does not take --dry-run\n' \
				"$command" >&2
			exit 2
		fi
		;;
	help)
		if [ -n "$selected" ]; then
			printf 'home: help takes no module names\n' >&2
			exit 2
		fi
		;;
	*)
		printf 'home: unknown verb: %s\n\n' "$command" >&2
		cmd_help >&2
		exit 2
		;;
esac

# Resolve the collection, then its one table. An explicit --env names a file
# relative to the caller and must exist; the collection .env is optional. With
# neither, modules get no table at all, never their own standalone .env.
collection_root=${root_option:-$PWD}
if [ -n "$env_option" ]; then
	case $env_option in /*) ;; *) env_option=$PWD/$env_option ;; esac
	[ -f "$env_option" ] || { printf 'home: no such env file: %s\n' "$env_option" >&2; exit 2; }
fi
cd -- "$collection_root"
env_file=$env_option
[ -n "$env_file" ] || [ ! -f .env ] || env_file=$PWD/.env
load_table
resolve_ordering

if [ "$post_command" = yes ]; then
    [ "$command" = install ] || { echo 'home: a command after -- requires install' >&2; exit 2; }
    [ -z "$DESTDIR" ] || { echo 'home: a command after -- cannot run with --destdir' >&2; exit 2; }
fi

# Continuation is a command policy, independent of module composition roles.
failure_policy=selection
case $command in
	stage | check) failure_policy=collect ;;
	install | apply) failure_policy=stop ;;
esac

repos=
[ "$command" = help ] || repos=$(resolve_repos)
operation_repos=$repos
excluded_repos=

"cmd_${command}"

if [ "$post_command" = yes ]; then
    if [ "$dry_run" = yes ]; then
        printf '\nWould run after install:'
        printf ' [%s]' "$@"
        printf '\n'
    else
        # The command sees the roots and table every module resolved, and
        # prefers the freshly installed commands. Argument boundaries are exact.
        for name in $table_names; do
            export "${name?}"
        done
        PATH="$BIN_DIR:$PATH"
        export PATH
        exec "$@"
    fi
fi
